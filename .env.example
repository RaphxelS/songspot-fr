# Spotify API — requis pour le catalogue live (sinon fallback JSON)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optionnel : liste d'IDs de playlists Spotify séparés par des virgules (override des playlists par défaut Top 50 France)
SPOTIFY_PLAYLIST_IDS=
# OAuth Titres aimés — requis pour le mode « Titres aimés »
# Redirect doit être exactement celui enregistré dans le dashboard Spotify (ex: http://localhost:3000/api/auth/spotify/callback)
SPOTIFY_REDIRECT_URI=
# Base URL publique (dérive la redirect si SPOTIFY_REDIRECT_URI non défini)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Feature flags — MVP désactivés
ENABLE_DEEZER_FALLBACK=false
ENABLE_V2_STYLES=false
